<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 注意: APIキーは含めない（macOS キーチェーンから読む）。Discord の認証情報も含めない。 -->
<!-- 時刻は Mac mini のシステム時刻帯（Asia/Tokyo）。05:30 に初回実行し、公開が失敗していれば 05:40・05:50 に再試行する（1回の上限は15分。最後の実行が 06:05 までに終わる）。
     GitHub Actions の既存 06:05 配信より前に公開を完了させるため、06:05 には起動しない。スリープ中の場合は起床後に実行される。 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rickykogyo.badminton-results</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__RUNNER__</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__WORKDIR__</string>
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>5</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>5</integer>
            <key>Minute</key>
            <integer>40</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>5</integer>
            <key>Minute</key>
            <integer>50</integer>
        </dict>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>BADMINTON_LOCAL_DIR</key>
        <string>__LOCALDIR__</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__LOGDIR__/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGDIR__/launchd.err.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
